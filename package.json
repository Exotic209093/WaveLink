{
  "name": "wavelink",
  "version": "0.6.0",
  "description": "A local-first Chrome extension for safer Salesforce data exports, imports, comparisons, schedules, and reusable jobs.",
  "private": true,
  "scripts": {
    "dev": "webpack --watch --config webpack.config.ts --mode development",
    "build": "webpack --config webpack.config.ts --mode production",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:dev": "npm audit --audit-level=high",
    "smoke:package": "node scripts/validate-package.js",
    "assets:store": "node scripts/generate-store-assets.js",
    "validate:salesforce": "ts-node --transpile-only --project scripts/tsconfig.json scripts/validate-salesforce-org.ts",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "package": "npm run build && npm run smoke:package && node scripts/package-extension.js"
  },
  "dependencies": {
    "papaparse": "^5.5.2",
    "preact": "^10.27.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "@types/jest-axe": "^3.5.9",
    "@types/papaparse": "^5.3.16",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "sharp": "^0.35.4",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4"
  },
  "license": "MIT",
  "author": "James C"
}
