# Regenerable or bulky render artefacts — the pipelines rebuild these.
output/*.wav

motion/output/**/build/
motion/output/**/previews/
motion/output/**/stills/

# Audio stems, cue maps and envelopes are regenerated by audio.py; keep only the
# chosen music beds so the committed videos can be re-rendered without new generations.
motion/output/**/audio/*
!motion/output/**/audio/candidates/
motion/output/**/audio/candidates/*
